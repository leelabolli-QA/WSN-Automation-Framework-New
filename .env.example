# Copy to `.env` and fill in real values. `.env` is git-ignored - never commit credentials.
#
# Every value can be given per environment by prefixing it with the ENV name
# (DEV_ / PROD_ / QA_). The framework checks the prefixed name first, then the
# flat name. Example: DEV_FACULTY_USERNAME wins over FACULTY_USERNAME when ENV=dev.

# ---------------------------------------------------------------------------
# Run configuration
# ---------------------------------------------------------------------------
ENV=dev
PERSONA=student
HEADLESS=false
SLOW_MO=0
TRACE_ON=false
LOG_LEVEL=INFO

# Overrides the base_url from config/config.yaml when set.
# BASE_URL=

# ---------------------------------------------------------------------------
# Persona credentials
# ---------------------------------------------------------------------------
STUDENT_USERNAME=wadhwani.foundation99@yopmail.com
STUDENT_PASSWORD=Demo@123

FACULTY_USERNAME=
FACULTY_PASSWORD=

RM_USERNAME=
RM_PASSWORD=

MENTOR_USERNAME=
MENTOR_PASSWORD=

CAREER_BUDDY_USERNAME=
CAREER_BUDDY_PASSWORD=

INSTITUTE_ADMIN_USERNAME=
INSTITUTE_ADMIN_PASSWORD=

# Zoom sandbox account used by the Settings > Zoom Connect scenarios.
ZOOM_USERNAME=demouser2078@gmail.com
ZOOM_PASSWORD=Demo@123
